__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
*.egg-info/
# Results: keep the summaries and aggregates, which are the data behind every
# number in docs/REPORT.md and are small enough to version.
# The per-run traces (results/traces_*.json) are only needed to redraw the
# trajectory figures; the experiments write them again.
results/*
!results/summary_*.json
!results/summary_*.csv
!results/aggregate_*.csv
!results/curves_*.json
!results/published_*.json
/data/

# training logs
logs_*/
