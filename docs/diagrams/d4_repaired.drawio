<mxfile host="drawio" agent="hand-written"><diagram id="Repaired MAACC" name="Repaired MAACC"><mxGraphModel dx="1200" dy="470" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="470" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Repaired MAACC: the paper's structure kept, its training fixed (a fair learning baseline)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=18;fontStyle=1;fontColor=#0B3C49;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1150" height="34" as="geometry"/></mxCell><mxCell id="c4" value="Kept from paper 1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FAFAF8;strokeColor=#A7B1B5;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#33444C;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="520" height="390" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;one agent per loop&lt;/b&gt;&lt;br&gt;oxygen, nitrate" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=8;fontFamily=Helvetica;fontSize=15;fillColor=#F1F1EE;strokeColor=#7A7A74;fontColor=#1B2A33;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="480" height="68" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;action network outputs an increment&lt;/b&gt;&lt;br&gt;u = a + b, with the PID prior b" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=8;fontFamily=Helvetica;fontSize=15;fillColor=#F1F1EE;strokeColor=#7A7A74;fontColor=#1B2A33;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="185" width="480" height="68" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;critic sees both loops and both actions&lt;/b&gt;&lt;br&gt;the coupling between loops" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=8;fontFamily=Helvetica;fontSize=15;fillColor=#F1F1EE;strokeColor=#7A7A74;fontColor=#1B2A33;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="480" height="68" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;starts exactly as the PID&lt;/b&gt;&lt;br&gt;last layer initialised at zero" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=8;fontFamily=Helvetica;fontSize=15;fillColor=#F1F1EE;strokeColor=#7A7A74;fontColor=#1B2A33;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="355" width="480" height="68" as="geometry"/></mxCell><mxCell id="c9" value="Repaired (standard fixes, as in MATD3)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#F4FBF7;strokeColor=#1B7F5A;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#0E3B2A;" vertex="1" parent="1"><mxGeometry x="600" y="60" width="580" height="390" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;replay buffer&lt;/b&gt;&lt;br&gt;every step kept and re-used (paper: used once)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=8;fontFamily=Helvetica;fontSize=15;fillColor=#E2F3EA;strokeColor=#1B7F5A;fontColor=#0E3B2A;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="620" y="100" width="540" height="68" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;target networks + twin critics&lt;/b&gt;&lt;br&gt;smaller of two critics, smoothed targets" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=8;fontFamily=Helvetica;fontSize=15;fillColor=#E2F3EA;strokeColor=#1B7F5A;fontColor=#0E3B2A;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="620" y="185" width="540" height="68" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;normalised inputs and reward&lt;/b&gt;&lt;br&gt;paper's learning signal was about 10⁻⁴" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=8;fontFamily=Helvetica;fontSize=15;fillColor=#E2F3EA;strokeColor=#1B7F5A;fontColor=#0E3B2A;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="620" y="270" width="540" height="68" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;bounded increment, warm-up day&lt;/b&gt;&lt;br&gt;tanh limit; one day of exploration first" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=8;fontFamily=Helvetica;fontSize=15;fillColor=#E2F3EA;strokeColor=#1B7F5A;fontColor=#0E3B2A;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="620" y="355" width="540" height="68" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>