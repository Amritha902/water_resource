<mxfile host="drawio" agent="hand-written"><diagram id="Daily ILC" name="Daily ILC"><mxGraphModel dx="1200" dy="470" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="470" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="How the daily ILC learns (one update per night, no neural network)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=18;fontStyle=1;fontColor=#0B3C49;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1150" height="34" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Day k&lt;/b&gt;&lt;br&gt;the PID controls; the ILC records the PID's input u_PID for every time of day (1 920 slots of 45 s)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#F1F1EE;strokeColor=#7A7A74;fontColor=#1B2A33;strokeWidth=1.5;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="300" height="150" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Midnight update&lt;/b&gt;&lt;br&gt;deviation from the day's mean, shifted 3 min earlier, smoothed ±22 min:&lt;br&gt;f ← f + β · shift(u_PID − mean)&lt;br&gt;β = 1 (tuned on dry week 1)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#E2F3EA;strokeColor=#1B7F5A;fontColor=#0E3B2A;strokeWidth=2.5;fontSize=14;" vertex="1" parent="1"><mxGeometry x="420" y="70" width="360" height="170" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Day k+1&lt;/b&gt;&lt;br&gt;f(time of day) is added to the PID's output, ahead of the daily load peak; the PID corrects less" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#F1F1EE;strokeColor=#7A7A74;fontColor=#1B2A33;strokeWidth=1.5;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="870" y="80" width="300" height="150" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#1B2A33;strokeWidth=1.8;fontFamily=Helvetica;fontSize=13;fontColor=#1B2A33;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#1B2A33;strokeWidth=1.8;fontFamily=Helvetica;fontSize=13;fontColor=#1B2A33;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="every day" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#1B2A33;strokeWidth=1.8;fontFamily=Helvetica;fontSize=13;fontColor=#1B2A33;labelBackgroundColor=#FFFFFF;strokeColor=#7A7A74;dashed=1;fontColor=#55606A;strokeWidth=1.4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1020" y="270"/><mxPoint x="180" y="270"/></Array></mxGeometry></mxCell><mxCell id="c10" value="&lt;b&gt;Bumpless transfer&lt;/b&gt; (round 2)&lt;br&gt;at midnight the same change is taken out of the PID's state, so the total input does not jump.&lt;br&gt;Largest oxygen deviation near midnight: 0.053 → 0.011 mg/L" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#E2F3EA;strokeColor=#1B7F5A;fontColor=#0E3B2A;strokeWidth=2.5;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="310" width="540" height="140" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Anti-windup&lt;/b&gt; (after held-out test 1)&lt;br&gt;the PID's limits move with f, and slots at an actuator limit teach nothing.&lt;br&gt;Under overload (new data): error −39 %; normal weather unchanged" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#E2F3EA;strokeColor=#1B7F5A;fontColor=#0E3B2A;strokeWidth=2.5;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="630" y="310" width="540" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>